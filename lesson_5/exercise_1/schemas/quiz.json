{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Quiz",
    "description": "API Representation cho thực thể đề thi",
    "type": "object",
    "required": [
        "id",
        "title",
        "durationMinutes",
        "passScore",
        "isPublished",
        "creatorId",
        "createdAt"
    ],
    "properties": {
        "id": {
            "type": "string",
            "pattern": "^quiz_[a-z0-9]+$"
        },
        "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
        },
        "description": {
            "type": "string"
        },
        "durationMinutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 300
        },
        "passScore": {
            "type": "number",
            "minimum": 0
        },
        "isPublished": {
            "type": "boolean"
        },
        "creatorId": {
            "type": "string",
            "pattern": "^usr_[a-z0-9]+$"
        },
        "createdAt": {
            "type": "string",
            "format": "date-time"
        },
        "updatedAt": {
            "type": "string",
            "format": "date-time"
        }
    },
    "additionalProperties": false
}